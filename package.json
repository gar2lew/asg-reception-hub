{
  "name": "reception-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "firebase emulators:exec --project demo-reception-hub-rules-test --only auth,firestore \"vitest run --config vitest.config.ts src/firebase/firestore.rules.test.ts\"",
    "emulators:start": "firebase emulators:start --project demo-reception-hub-rules-test --only auth,firestore"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "bcrypt": "^6.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.25.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
